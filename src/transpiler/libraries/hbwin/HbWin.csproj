<Project Sdk="Microsoft.NET.Sdk">

  <!-- The hbwin contrib library for transpiled Harbour code. The emitter
       routes every name contrib/hbwin/hbwin.hbx lists to `HbWin.<name>`;
       an application references this project only once the library is
       taken on, so until then each call fails at its call site. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <RootNamespace>HbWin</RootNamespace>
    <AssemblyName>HbWin</AssemblyName>
  </PropertyGroup>

</Project>
