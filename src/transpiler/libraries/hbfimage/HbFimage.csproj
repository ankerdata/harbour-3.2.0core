<Project Sdk="Microsoft.NET.Sdk">

  <!-- The hbfimage contrib library for transpiled Harbour code. The emitter
       routes every name contrib/hbfimage/hbfimage.hbx lists to `HbFimage.<name>`.
       Real implementations live in HbFimage.cs; HbFimage.Stubs.cs holds a
       NotImplementedException stub for every other name the application
       calls, written by easipos-transpiled's scripts/gen_library_stubs.py. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <RootNamespace>HbFimage</RootNamespace>
    <AssemblyName>HbFimage</AssemblyName>
  </PropertyGroup>

</Project>
