<Project Sdk="Microsoft.NET.Sdk">

  <!-- The hbsqlit3 contrib library for transpiled Harbour code. The emitter
       routes every name contrib/hbsqlit3/hbsqlit3.hbx lists to `HbSqlit3.<name>`.
       Real implementations live in HbSqlit3.cs; HbSqlit3.Stubs.cs holds a
       NotImplementedException stub for every other name the application
       calls, written by easipos-transpiled's scripts/gen_library_stubs.py. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <RootNamespace>HbSqlit3</RootNamespace>
    <AssemblyName>HbSqlit3</AssemblyName>
  </PropertyGroup>

</Project>
