<Project Sdk="Microsoft.NET.Sdk">

  <!-- The hbzebra contrib library for transpiled Harbour code. The emitter
       routes every name contrib/hbzebra/hbzebra.hbx lists to `HbZebra.<name>`.
       Real implementations live in HbZebra.cs; HbZebra.Stubs.cs holds a
       NotImplementedException stub for every other name the application
       calls, written by easipos-transpiled's scripts/gen_library_stubs.py. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <RootNamespace>HbZebra</RootNamespace>
    <AssemblyName>HbZebra</AssemblyName>
  </PropertyGroup>

</Project>
