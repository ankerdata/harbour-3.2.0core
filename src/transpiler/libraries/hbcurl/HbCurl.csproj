<Project Sdk="Microsoft.NET.Sdk">

  <!-- The hbcurl contrib library for transpiled Harbour code. The emitter
       routes every name contrib/hbcurl/hbcurl.hbx lists to `HbCurl.<name>`.
       Real implementations live in HbCurl.cs; HbCurl.Stubs.cs holds a
       NotImplementedException stub for every other name the application
       calls, written by easipos-transpiled's scripts/gen_library_stubs.py. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <RootNamespace>HbCurl</RootNamespace>
    <AssemblyName>HbCurl</AssemblyName>
  </PropertyGroup>

</Project>
