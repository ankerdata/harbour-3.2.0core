<Project Sdk="Microsoft.NET.Sdk">

  <!-- The hbct contrib library for transpiled Harbour code. The emitter
       routes every name contrib/hbct/hbct.hbx lists to `HbCt.<name>`.
       Real implementations live in HbCt.cs; HbCt.Stubs.cs holds a
       NotImplementedException stub for every other name the application
       calls, written by easipos-transpiled's scripts/gen_library_stubs.py. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <RootNamespace>HbCt</RootNamespace>
    <AssemblyName>HbCt</AssemblyName>
  </PropertyGroup>

</Project>
