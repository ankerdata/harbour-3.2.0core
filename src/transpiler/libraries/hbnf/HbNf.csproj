<Project Sdk="Microsoft.NET.Sdk">

  <!-- The hbnf contrib library for transpiled Harbour code. The emitter
       routes every name contrib/hbnf/hbnf.hbx lists to `HbNf.<name>`.
       Real implementations live in HbNf.cs; HbNf.Stubs.cs holds a
       NotImplementedException stub for every other name the application
       calls, written by easipos-transpiled's scripts/gen_library_stubs.py. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <RootNamespace>HbNf</RootNamespace>
    <AssemblyName>HbNf</AssemblyName>
  </PropertyGroup>

</Project>
