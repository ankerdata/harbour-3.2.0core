<Project Sdk="Microsoft.NET.Sdk">

  <!-- The hbmzip contrib library for transpiled Harbour code. The emitter
       routes every name contrib/hbmzip/hbmzip.hbx lists to `HbMzip.<name>`.
       Real implementations live in HbMzip.cs; HbMzip.Stubs.cs holds a
       NotImplementedException stub for every other name the application
       calls, written by easipos-transpiled's scripts/gen_library_stubs.py. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <RootNamespace>HbMzip</RootNamespace>
    <AssemblyName>HbMzip</AssemblyName>
  </PropertyGroup>

</Project>
