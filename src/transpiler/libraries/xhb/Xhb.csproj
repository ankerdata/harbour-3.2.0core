<Project Sdk="Microsoft.NET.Sdk">

  <!-- The xhb contrib library for transpiled Harbour code. The emitter
       routes every name contrib/xhb/xhb.hbx lists to `Xhb.<name>`;
       an application references this project only once the library is
       taken on, so until then each call fails at its call site. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <RootNamespace>Xhb</RootNamespace>
    <AssemblyName>Xhb</AssemblyName>
  </PropertyGroup>

</Project>
