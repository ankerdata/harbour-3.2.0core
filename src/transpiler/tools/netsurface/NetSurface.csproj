<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reads .NET assemblies and writes the transpiler's extern table:
       the classes a Harbour program reaches through COM (EasiPOS's
       EasiPos.* shims) and their methods, in the reftab's row format.
       See Program.cs and the transpiler README, "External .NET classes". -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />
  </ItemGroup>

</Project>
